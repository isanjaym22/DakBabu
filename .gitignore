# DakBabu .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environment
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
*.spec.bak

# PyInstaller
*.manifest
*.spec.tmp

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.lnk

# Zone.Identifier files (Windows security metadata)
*Zone.Identifier

# Test / Coverage
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# Temp files
*.tmp
*.temp
*.bak
*.log

# Generated PDFs (temp output during development)
temp_pdfs/
*:Zone.Identifier
